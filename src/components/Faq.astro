---
// Zichtbare FAQ (uitklapbaar) + FAQPage structured data voor Google/AI.
const { vragen = [], titel = 'Veelgestelde vragen' } = Astro.props;

const jsonLd = vragen.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: vragen.map((v) => ({
        '@type': 'Question',
        name: v.vraag,
        acceptedAnswer: { '@type': 'Answer', text: v.antwoord },
      })),
    }
  : null;
---

{vragen.length > 0 && (
  <div class="faq">
    <h2 class="cat-heading">{titel}</h2>
    <div class="faq-lijst">
      {vragen.map((v) => (
        <details class="faq-item">
          <summary>{v.vraag}</summary>
          <p>{v.antwoord}</p>
        </details>
      ))}
    </div>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </div>
)}
