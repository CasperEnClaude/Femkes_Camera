---
import site from '../data/site.json';
import { igHandle, igUrl, plaats } from '../lib/site.js';
import InstaIcon from './InstaIcon.astro';
const { theme = 'light' } = Astro.props;

const waRaw = (site.whatsapp || '').trim();
const waNumber = waRaw.replace(/[^0-9]/g, '');
const waLink = (waNumber.length >= 8 && !waRaw.startsWith('[')) ? `https://wa.me/${waNumber}` : null;
const mailLink = site.email && !site.email.startsWith('[') ? `mailto:${site.email}` : null;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-col">
      <span class="footer-brand">{site.merknaam}</span>
      <p class="footer-tag">{site.tagline}</p>
      {plaats && <p class="footer-plaats">Dierenfotografie in en rond {plaats}</p>}
      {igUrl && (
        <a href={igUrl} class="footer-ig" rel="noopener me" target="_blank">
          <InstaIcon size={20} /> <span>@{igHandle}</span>
        </a>
      )}
    </div>

    <div class="footer-col">
      <h2 class="footer-h">Contact</h2>
      <ul class="footer-links">
        {waLink && <li><a href={waLink} rel="noopener">WhatsApp</a></li>}
        {mailLink && <li><a href={mailLink}>E-mail</a></li>}
        {igUrl && <li><a href={igUrl} rel="noopener" target="_blank">Instagram</a></li>}
        <li><a href="/contact">Boek een shoot</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h2 class="footer-h">Ook interessant</h2>
      <ul class="footer-links">
        <li><a href="/portfolio">Portfolio</a></li>
        <li><a href="/prijzen">Prijzen</a></li>
        <li><a href="/rookfakkels">Rookfakkels</a></li>
        <li><a href="/motor">Motorfotografie</a></li>
      </ul>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {year} {site.merknaam}</span>
    <span class="footer-legal">
      <a href="/privacy">Privacybeleid</a>
      <a href="/voorwaarden">Algemene voorwaarden</a>
    </span>
  </div>
</footer>
