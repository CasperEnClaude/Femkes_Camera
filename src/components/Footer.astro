---
import site from '../data/site.json';
import { igHandle, igUrl, waLink, mailLink, plaats, werkgebiedBasis, werkgebiedOpAanvraag } from '../lib/site.js';
import InstaIcon from './InstaIcon.astro';
const { theme = 'light' } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-col">
      <span class="footer-brand">{site.merknaam}</span>
      <p class="footer-tag">{site.tagline}</p>
      {igUrl && (
        <a href={igUrl} class="footer-ig" rel="noopener me" target="_blank">
          <InstaIcon size={20} /> <span>@{igHandle}</span>
        </a>
      )}
    </div>

    <div class="footer-col">
      <h2 class="footer-h">Fotografie</h2>
      <ul class="footer-links">
        <li><a href="/hondenfotografie">Honden</a></li>
        <li><a href="/puppyshoot">Puppy's</a></li>
        <li><a href="/agility-fotografie">Agility</a></li>
        <li><a href="/paardenfotografie">Paarden</a></li>
        <li><a href="/rookfakkels">Rookfakkels</a></li>
        <li><a href="/motor">Motor</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h2 class="footer-h">Contact</h2>
      <ul class="footer-links">
        {waLink && <li><a href={waLink} rel="noopener" target="_blank">WhatsApp</a></li>}
        {mailLink && <li><a href={mailLink}>E-mail</a></li>}
        {igUrl && <li><a href={igUrl} rel="noopener" target="_blank">Instagram</a></li>}
        <li><a href="/contact">Boek een shoot</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h2 class="footer-h">Informatie</h2>
      <ul class="footer-links">
        <li><a href="/prijzen">Prijzen</a></li>
        <li><a href="/cadeaubon">Cadeaubon</a></li>
        <li><a href="/voorwaarden">Algemene voorwaarden</a></li>
        <li><a href="/privacy">Privacybeleid</a></li>
      </ul>
      {werkgebiedBasis && (
        <p class="footer-werkgebied">{werkgebiedBasis}{werkgebiedOpAanvraag ? `. ${werkgebiedOpAanvraag}.` : '.'}</p>
      )}
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {year} {site.merknaam}</span>
    <span class="footer-legal">
      <a href="/privacy">Privacybeleid</a>
      <a href="/voorwaarden">Algemene voorwaarden</a>
    </span>
  </div>
</footer>
