---
import site from '../data/site.json';
import { igUrl } from '../lib/site.js';
import InstaIcon from './InstaIcon.astro';
const { theme = 'light' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

// Dieren staan voorop; creative en motor zijn secundair (kleiner, verderop).
// "Boeken" is de enige call-to-action — geen aparte, identieke Contact-pagina ernaast.
const nav = [
  { href: '/', label: 'Home' },
  { href: '/portfolio', label: 'Portfolio' },
  { href: '/prijzen', label: 'Prijzen' },
  { href: '/voorbereiding', label: 'Voorbereiding' },
  { href: '/over-mij', label: 'Over mij' },
];

function isActive(href) {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href + '/');
}
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">
      <span class="brand-name">{site.merknaam}</span>
      <span class="brand-tag">{site.tagline}</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" hidden />

    <div class="header-actions">
      {igUrl && (
        <a href={igUrl} class="header-ig" rel="noopener" target="_blank" aria-label="Femke's Camera op Instagram">
          <InstaIcon size={22} />
        </a>
      )}
      <label for="nav-toggle" class="nav-burger" aria-label="Menu openen">
        <span></span><span></span><span></span>
      </label>
    </div>

    <nav class="site-nav" aria-label="Hoofdmenu">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={['nav-link', { active: isActive(item.href) }]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
      {igUrl && (
        <a href={igUrl} class="nav-link nav-ig-link" rel="noopener" target="_blank">
          <InstaIcon size={18} cls="nav-ig-ico" /> Instagram
        </a>
      )}
      <a href="/contact" class:list={['nav-cta', { active: isActive('/contact') }]}>Boek een shoot</a>
    </nav>
  </div>
</header>
