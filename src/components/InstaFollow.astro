---
import { Image } from 'astro:assets';
import { resolveImage } from '../lib/images.js';
import { igHandle, igUrl } from '../lib/site.js';
import InstaIcon from './InstaIcon.astro';

// Horizontale "feed"-strook die je zijwaarts swipet — bewust anders dan het
// verticale categorie-raster erboven, en met andere foto's (geen dubbeling).
import honden from '../galleries/honden.json';
import puppys from '../galleries/puppys.json';
import agility from '../galleries/agility.json';
import motor from '../galleries/motor.json';
import creative from '../galleries/creative.json';

const pool = [
  honden.photos?.[5], puppys.photos?.[2], agility.photos?.[3], motor.photos?.[1],
  honden.photos?.[9], creative.photos?.[1], puppys.photos?.[6], agility.photos?.[6],
  honden.photos?.[11],
].filter(Boolean);

const tiles = pool
  .map((p) => ({ ...p, resolved: resolveImage(p.image) }))
  .filter((p) => p.resolved);

const heading = igHandle ? `@${igHandle}` : 'Volg mee op Instagram';
---

<section class="insta-section">
  <div class="container">
    <div class="insta-head">
      <div>
        <span class="insta-kicker"><InstaIcon size={18} cls="insta-kicker-ico" /> Instagram</span>
        <h2 class="insta-title">{heading}</h2>
        <p class="insta-sub">Het laatste werk en sfeer achter de schermen — daar deel ik het eerst.</p>
      </div>
      {igUrl && (
        <a href={igUrl} class="btn btn-primary insta-follow-btn" rel="noopener me" target="_blank">
          <InstaIcon size={20} cls="btn-ico" /> Volgen
        </a>
      )}
    </div>
  </div>

  <div class="insta-strip" role="list">
    {tiles.map((p) => (
      igUrl ? (
        <a href={igUrl} class="insta-cell" role="listitem" rel="noopener" target="_blank" aria-label="Bekijk op Instagram">
          <Image src={p.resolved} alt={p.naam || 'Foto van Femke\'s Camera'} widths={[220, 440]} sizes="180px" loading="lazy" class="insta-img" />
          <span class="insta-cell-ico" aria-hidden="true"><InstaIcon size={22} /></span>
        </a>
      ) : (
        <figure class="insta-cell" role="listitem">
          <Image src={p.resolved} alt={p.naam || 'Foto van Femke\'s Camera'} widths={[220, 440]} sizes="180px" loading="lazy" class="insta-img" />
        </figure>
      )
    ))}
  </div>
</section>
