---
import { Image } from 'astro:assets';
import { resolveImage } from '../lib/images.js';

// Verwacht: gallery = { titel, categorie, photos: [{image, naam, bijschrift}] }
const { gallery } = Astro.props;
const photos = (gallery?.photos || [])
  .map((p) => ({ ...p, resolved: resolveImage(p.image) }))
  .filter((p) => p.resolved);
---

{photos.length === 0 ? (
  <p class="gallery-empty">
    Binnenkort komen hier de foto's van <strong>{gallery?.titel}</strong>.
  </p>
) : (
  <div class="gallery-grid">
    {photos.map((p, i) => (
      <figure class="gallery-item">
        <Image
          src={p.resolved}
          alt={p.naam || gallery.titel}
          widths={[400, 800, 1200]}
          sizes="(max-width: 640px) 50vw, (max-width: 1000px) 33vw, 33vw"
          loading={i < 6 ? 'eager' : 'lazy'}
          class="gallery-img"
        />
        {p.bijschrift && <figcaption class="gallery-caption">{p.bijschrift}</figcaption>}
      </figure>
    ))}
  </div>
)}
