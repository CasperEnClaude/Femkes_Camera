---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import PackageCard from '../components/PackageCard.astro';
import Reviews from '../components/Reviews.astro';
import Walkthrough from '../components/Walkthrough.astro';
import Faq from '../components/Faq.astro';
import InstaIcon from '../components/InstaIcon.astro';
import { resolveImage } from '../lib/images.js';
import { igUrl, werkgebiedBasis } from '../lib/site.js';
import hondenGallery from '../galleries/honden.json';
import prijzen from '../data/prijzen.json';

const dieren = prijzen.dieren;
const heroPhoto = hondenGallery.photos?.[0];
const heroImg = heroPhoto ? resolveImage(heroPhoto.image) : undefined;

const stappen = [
  { titel: 'Even afstemmen', tekst: 'Vooraf bespreken we kort wat je wilt, waar we fotograferen en wanneer het jou en je hond uitkomt.' },
  { titel: 'Rustig beginnen', tekst: 'Op locatie geef ik je hond eerst even de tijd om te wennen. Geen haast — dat werkt altijd het best.' },
  { titel: 'De shoot zelf', tekst: 'Ik werk met het gedrag mee: een balletje, wat snoep en veel geduld. Zo krijgen we natuurlijke beelden zonder geforceerde poses.' },
  { titel: 'Selectie & bewerking', tekst: 'Ik kies de sterkste foto\'s en bewerk ze in mijn eigen, natuurlijke stijl.' },
  { titel: 'Levering', tekst: 'Je ontvangt je foto\'s digitaal via een online galerij, klaar om te delen of te printen.' },
];

const vragen = [
  { vraag: 'Hoe lang duurt een hondenshoot?', antwoord: 'Afhankelijk van je pakket 45 minuten tot ongeveer 2 uur. We nemen rustig de tijd, zodat je hond zich op zijn gemak voelt.' },
  { vraag: 'Wat als mijn hond niet stilzit?', antwoord: 'Geen probleem — dat hoeft ook niet. Ik werk juist met beweging en gedrag mee. Een hond die speelt of snuffelt levert vaak de mooiste beelden op.' },
  { vraag: 'Mag mijn hond loslopen tijdens de shoot?', antwoord: 'Als de locatie het toelaat en je hond betrouwbaar terugkomt, kan dat prima. Anders werken we met een lange lijn die ik later kan wegbewerken.' },
  { vraag: 'Kan ik meerdere honden laten fotograferen?', antwoord: 'Ja. Bij het Plus-pakket kunnen er tot 4 dieren mee, bij Compleet meerdere dieren uit hetzelfde gezin.' },
  { vraag: 'Wanneer ontvang ik de foto\'s?', antwoord: 'Dat spreken we samen af; meestal lukt dat binnen een paar weken.' },
];
---

<Base
  title="Hondenfotograaf Rotterdam"
  description="Hondenfotografie in Rotterdam en omgeving: natuurlijke, herkenbare beelden van je hond. Rustig, geduldig en in het eigen tempo. Shoots vanaf €65."
>
  <section class="hero photo-hero">
    {heroImg ? (
      <Image src={heroImg} alt={heroPhoto.naam || 'Hondenfotografie'} widths={[600, 1200, 1800]} sizes="100vw" loading="eager" class="hero-img" />
    ) : (
      <div class="hero-img hero-placeholder" aria-hidden="true"></div>
    )}
    <div class="hero-overlay">
      <div class="container hero-content">
        <span class="hero-kicker">Hondenfotografie</span>
        <h1>Hondenfotograaf {werkgebiedBasis || 'in de regio'}</h1>
        <p class="hero-lead">Je hond zoals hij écht is — spelend, alert of gewoon lekker zichzelf.</p>
        <div class="hero-cta">
          <a href="/contact?pakket=Plus" class="btn btn-primary">Plan een shoot</a>
          {igUrl && <a href={igUrl} class="btn btn-ghost" rel="noopener" target="_blank"><InstaIcon size={18} cls="btn-ico" /> Instagram</a>}
        </div>
      </div>
    </div>
  </section>

  <section class="container section narrow">
    <p class="prose">Ik fotografeer honden in {werkgebiedBasis || 'de regio Rotterdam'}: natuurlijk, spontaan en in het eigen tempo. Van rustige portretten tot volle actie, buiten in het park of op een vertrouwde plek dicht bij huis.</p>
    <p class="prose">Ik werk uitsluitend met dieren. Daardoor weet ik precies hoe ik een hond rustig krijg, wanneer ik moet wachten en wanneer het moment er is. Overdag werk ik in een dierenspeciaalzaak, dus ik ben dagelijks met honden bezig en lees hun gedrag. Een shoot voelt daardoor rustig — geen gedoe, geen geforceerde standjes, wel beelden waarin je je hond herkent.</p>
  </section>

  <section class="container section">
    <h2 class="cat-heading">Pakketten</h2>
    <p class="blok-intro">{dieren.intro}</p>
    <div class="package-grid primary-grid">
      {dieren.pakketten.map((p) => <PackageCard pakket={p} />)}
    </div>
    <p class="landing-link"><a href="/prijzen">Alle prijzen en extra's →</a></p>
  </section>

  <section class="container section">
    <h2 class="cat-heading">Werk</h2>
    <Gallery gallery={hondenGallery} />
  </section>

  <section class="container section narrow">
    <Walkthrough stappen={stappen} />
  </section>

  <section class="container section"><Reviews category="honden" count={3} /></section>

  <section class="container section narrow">
    <Faq vragen={vragen} />
  </section>

  <section class="band">
    <div class="container band-inner center">
      <h2>Mooie foto's van je hond?</h2>
      <p>Stuur me een bericht, dan denk ik met je mee over het juiste pakket.</p>
      <a href="/contact?pakket=Plus" class="btn btn-primary">Neem contact op</a>
    </div>
  </section>
</Base>
