---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import PackageCard from '../components/PackageCard.astro';
import Reviews from '../components/Reviews.astro';
import InstaIcon from '../components/InstaIcon.astro';
import { resolveImage } from '../lib/images.js';
import { igUrl, werkgebiedBasis } from '../lib/site.js';
import hondenGallery from '../galleries/honden.json';
import prijzen from '../data/prijzen.json';

const dieren = prijzen.dieren;
const heroPhoto = hondenGallery.photos?.[0];
const heroImg = heroPhoto ? resolveImage(heroPhoto.image) : undefined;
---

<Base
  title="Hondenfotograaf Rotterdam"
  description="Hondenfotografie in Rotterdam en omgeving: natuurlijke, herkenbare beelden van je hond. Rustig, geduldig en in het eigen tempo. Shoots vanaf €75."
>
  <section class="hero photo-hero">
    {heroImg ? (
      <Image src={heroImg} alt={heroPhoto.naam || 'Hondenfotografie'} widths={[600, 1200, 1800]} sizes="100vw" loading="eager" class="hero-img" />
    ) : (
      <div class="hero-img hero-placeholder" aria-hidden="true"></div>
    )}
    <div class="hero-overlay">
      <div class="container hero-content">
        <span class="hero-kicker">Hondenfotografie</span>
        <h1>Hondenfotograaf {werkgebiedBasis || 'in de regio'}</h1>
        <p class="hero-lead">Je hond zoals hij écht is — zijn blik, zijn karakter, dat ene koppige kopje.</p>
        <div class="hero-cta">
          <a href="/contact?pakket=Compleet" class="btn btn-primary">Plan een shoot</a>
          {igUrl && <a href={igUrl} class="btn btn-ghost" rel="noopener" target="_blank"><InstaIcon size={18} cls="btn-ico" /> Instagram</a>}
        </div>
      </div>
    </div>
  </section>

  <section class="container section narrow">
    <p class="prose">Je hond is er niet voor altijd — een sterke foto wel. Ik fotografeer honden in {werkgebiedBasis || 'Rotterdam en omgeving'}: natuurlijk, spontaan en in het eigen tempo. Van rustige portretten tot volle actie, buiten in het park of op een vertrouwde plek dicht bij huis.</p>
    <p class="prose">Ik werk uitsluitend met dieren. Daardoor weet ik precies hoe ik een hond rustig krijg, wanneer ik moet wachten en wanneer het moment er is. Overdag werk ik in een dierenspeciaalzaak, dus ik ben dagelijks met honden bezig en lees hun gedrag. Een shoot voelt daardoor rustig — geen gestress, geen geforceerde standjes, wel beelden waarin je je hond herkent.</p>
    <h2 class="cat-heading">Oudere honden</h2>
    <p class="prose">Wordt je hond ouder? Dan is dit precies het goede moment. Ik fotografeer regelmatig oudere honden — rustig, in het eigen tempo, thuis of op een vertrouwde plek.</p>
  </section>

  <section class="container section">
    <h2 class="cat-heading">Pakketten</h2>
    <p class="blok-intro">{dieren.intro}</p>
    <div class="package-grid primary-grid">
      {dieren.pakketten.map((p) => <PackageCard pakket={p} />)}
    </div>
    <p class="landing-link"><a href="/prijzen">Alle prijzen en extra's →</a></p>
  </section>

  <section class="container section">
    <h2 class="cat-heading">Werk</h2>
    <Gallery gallery={hondenGallery} />
  </section>

  <section class="container section"><Reviews category="honden" count={3} /></section>

  <section class="band">
    <div class="container band-inner center">
      <h2>Mooie foto's van je hond?</h2>
      <p>Stuur me een bericht, dan denk ik met je mee over het juiste pakket.</p>
      <a href="/contact?pakket=Compleet" class="btn btn-primary">Neem contact op</a>
    </div>
  </section>
</Base>
