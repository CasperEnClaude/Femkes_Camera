---
import Base from '../layouts/Base.astro';
import InstaIcon from '../components/InstaIcon.astro';
import WhatsIcon from '../components/WhatsIcon.astro';
import { igUrl, email, mailLink, waLink, plaats, werkgebiedBasis, werkgebiedOpAanvraag } from '../lib/site.js';

const waText = encodeURIComponent('Hoi Femke! Ik wil graag een shoot boeken voor mijn ');
const waBook = waLink ? `${waLink}?text=${waText}` : null;

const pakketOpties = [
  'Basis',
  'Plus',
  'Compleet',
  'Puppyshoot',
  'Puppyjaar',
  'Nestreportage',
  'Rookfakkelshoot',
  'Motorshoot',
  'Clubs & verenigingen',
  'Cadeaubon',
  'Weet ik nog niet',
];
---

<Base title="Boek een shoot in Rotterdam en omgeving" description="Boek een dierenshoot in Rotterdam en omgeving via het formulier, WhatsApp of e-mail. Geen druk, ik denk met je mee.">
  <section class="container section narrow">
    <h1 class="page-title">Boek een shoot</h1>
    <p class="prose">Leuk dat je een shoot overweegt! Vul het formulier in, dan reageer ik zo snel mogelijk. Liever appen, mailen of een DM op Instagram? Dat kan ook.{werkgebiedBasis ? ` Ik werk in ${werkgebiedBasis}${werkgebiedOpAanvraag ? `; ${werkgebiedOpAanvraag.toLowerCase()}` : ''}.` : ''}</p>

    <form name="boeking" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/bedankt" class="boek-form">
      <input type="hidden" name="form-name" value="boeking" />
      <p class="hp-field"><label>Laat dit veld leeg: <input name="bot-field" /></label></p>

      <div class="form-row">
        <label for="naam">Je naam <span class="req">*</span></label>
        <input id="naam" name="naam" type="text" required autocomplete="name" />
      </div>

      <div class="form-grid">
        <div class="form-row">
          <label for="email">E-mailadres <span class="req">*</span></label>
          <input id="email" name="email" type="email" required autocomplete="email" />
        </div>
        <div class="form-row">
          <label for="telefoon">Telefoonnummer</label>
          <input id="telefoon" name="telefoon" type="tel" autocomplete="tel" />
        </div>
      </div>

      <div class="form-grid">
        <div class="form-row">
          <label for="dier">Soort dier en naam</label>
          <input id="dier" name="dier" type="text" placeholder="bijv. hond, Bumper" />
        </div>
        <div class="form-row">
          <label for="pakket">Welk pakket spreekt je aan</label>
          <select id="pakket" name="pakket">
            {pakketOpties.map((p) => <option value={p}>{p}</option>)}
          </select>
        </div>
      </div>

      <div class="form-grid">
        <div class="form-row">
          <label for="periode">Voorkeursperiode</label>
          <input id="periode" name="periode" type="text" placeholder="bijv. eind september, of een weekend" />
        </div>
        <div class="form-row">
          <label for="locatie">Locatie of plaats <span class="req">*</span></label>
          <input id="locatie" name="locatie" type="text" required placeholder={plaats ? `bijv. ${plaats}` : 'bijv. je woonplaats'} />
        </div>
      </div>

      <div class="form-row">
        <label for="bericht">Je bericht</label>
        <textarea id="bericht" name="bericht" rows="4" placeholder="Vertel kort iets over je dier of je wensen."></textarea>
      </div>

      <label class="form-check">
        <input type="checkbox" name="toestemming_publicatie" value="ja" />
        <span>Ik geef toestemming om de foto's te gebruiken op de website en social media van Femke's Camera.</span>
      </label>
      <label class="form-check">
        <input type="checkbox" name="herinnering" value="ja" />
        <span>Stuur me over een jaar een herinnering voor een nieuwe shoot.</span>
      </label>

      <button type="submit" class="btn btn-primary">Verstuur boekingsaanvraag</button>
      <p class="form-note">Geen betaling of verplichting, dit is een aanvraag. Ik neem contact met je op om alles af te stemmen.</p>
    </form>

    {(waBook || mailLink || igUrl) && (
      <>
        <div class="of-scheiding"><span>of neem direct contact op</span></div>
        <div class="contact-cards">
          {waBook && (
            <a href={waBook} class="contact-card wa" rel="noopener" target="_blank">
              <span class="contact-icon wa-icon" aria-hidden="true"><WhatsIcon size={30} /></span>
              <span class="contact-label">WhatsApp</span>
              <span class="contact-sub">Snelst, met een kant-en-klaar berichtje</span>
            </a>
          )}
          {mailLink && (
            <a href={mailLink} class="contact-card mail">
              <span class="contact-icon" aria-hidden="true">✉️</span>
              <span class="contact-label">E-mail</span>
              <span class="contact-sub">{email}</span>
            </a>
          )}
          {igUrl && (
            <a href={igUrl} class="contact-card ig" rel="noopener" target="_blank">
              <span class="contact-icon ig-icon" aria-hidden="true"><InstaIcon size={28} /></span>
              <span class="contact-label">Instagram</span>
              <span class="contact-sub">Bekijk mijn laatste werk</span>
            </a>
          )}
        </div>
      </>
    )}

    <div class="gerust-box">
      <p><strong>Geen druk.</strong> Twijfel je nog of heb je een vraag over wat past bij jouw dier? Stel hem gerust, ik denk graag met je mee.</p>
    </div>
  </section>

  <script is:inline>
    (function () {
      var params = new URLSearchParams(window.location.search);
      var pakket = params.get('pakket');
      if (pakket) {
        var sel = document.getElementById('pakket');
        if (sel) {
          var match = Array.from(sel.options).find(function (o) { return o.value.toLowerCase() === pakket.toLowerCase(); });
          if (!match) { match = new Option(pakket, pakket, true, true); sel.add(match, 0); }
          sel.value = match.value;
        }
      }
    })();
  </script>
</Base>
