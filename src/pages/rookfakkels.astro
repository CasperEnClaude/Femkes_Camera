---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import PackageCard from '../components/PackageCard.astro';
import InstaIcon from '../components/InstaIcon.astro';
import { resolveImage } from '../lib/images.js';
import { igUrl } from '../lib/site.js';
import creativeGallery from '../galleries/creative.json';
import prijzen from '../data/prijzen.json';

const rf = prijzen.rookfakkels;
const heroPhoto = creativeGallery.photos?.[1] || creativeGallery.photos?.[0];
const heroImg = heroPhoto ? resolveImage(heroPhoto.image) : undefined;
---

<Base
  title="Rookfakkelshoot Rotterdam"
  description="Rookfakkelshoots in Rotterdam en omgeving — kleurrijke rook rond je hond voor stoere, filmische beelden. Vanaf €135."
>
  <section class="hero photo-hero">
    {heroImg ? (
      <Image src={heroImg} alt={heroPhoto.naam || 'Rookfakkel-shoot'} widths={[600, 1200, 1800]} sizes="100vw" loading="eager" class="hero-img" />
    ) : (
      <div class="hero-img hero-placeholder" aria-hidden="true"></div>
    )}
    <div class="hero-overlay">
      <div class="container hero-content">
        <span class="hero-kicker">Kleur &amp; sfeer</span>
        <h1>Rookfakkel-shoots</h1>
        <p class="hero-lead">{rf.intro}</p>
        <div class="hero-cta">
          <a href="/contact?pakket=Rookfakkel-shoot" class="btn btn-primary">Plan een rookfakkel-shoot</a>
          {igUrl && <a href={igUrl} class="btn btn-ghost" rel="noopener" target="_blank"><InstaIcon size={18} cls="btn-ico" /> Instagram</a>}
        </div>
      </div>
    </div>
  </section>

  <section class="container section">
    <h2 class="cat-heading">Werk</h2>
    <Gallery gallery={creativeGallery} />
  </section>

  <section class="container section">
    <h2 class="cat-heading">Wat een rookfakkel-shoot kost</h2>
    <div class="landing-prijs">
      <div class="package-grid single">
        {rf.pakketten.map((p) => <PackageCard pakket={p} />)}
      </div>
      <div class="opties-blok">
        <h3>Uitbreiden kan</h3>
        <ul class="opties-lijst">
          {rf.opties.map((o) => (
            <li>
              <span class="optie-naam">{o.naam}{o.hint && <span class="optie-hint"> — {o.hint}</span>}</span>
              <span class="optie-prijs">{o.meerprijs}</span>
            </li>
          ))}
          {rf.addon && (
            <li class="optie-addon">
              <span class="optie-naam">{rf.addon.naam} <span class="optie-badge">op aanvraag</span></span>
              <span class="optie-prijs">{rf.addon.meerprijs}</span>
            </li>
          )}
        </ul>
        {rf.note && <p class="klein-note">{rf.note}</p>}
      </div>
    </div>
    {rf.creatief && (
      <div class="creatief-blok">
        <h3>Breder dan alleen rook</h3>
        <p>{rf.creatief}</p>
      </div>
    )}
    <div class="creatief-blok">
      <h3>Veilig werken met rookfakkels</h3>
      <p>Ik werk met rookfakkels op rustige, veilige plekken en in overleg met jou. Bij droogte of verhoogd natuurbrandgevaar verplaats ik de shoot — kosteloos. De locatie kiezen we samen; als we op privéterrein fotograferen, regel jij vooraf toestemming van de eigenaar. Twijfel je of je hond gevoelig is voor rook of geluid, laat het weten — dan doen we het rustig aan of kiezen we een alternatief.</p>
    </div>
  </section>

  <section class="band">
    <div class="container band-inner center">
      <h2>Iets kleurrijks maken van jouw hond?</h2>
      <p>Stuur me een bericht — ik denk graag mee over kleur en locatie.</p>
      <a href="/contact?pakket=Rookfakkel-shoot" class="btn btn-primary">Neem contact op</a>
    </div>
  </section>
</Base>
