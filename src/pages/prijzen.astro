---
import Base from '../layouts/Base.astro';
import PackageCard from '../components/PackageCard.astro';
import Reviews from '../components/Reviews.astro';
import prijzen from '../data/prijzen.json';
import { reiskostenRegel } from '../lib/site.js';

const { dieren, puppy, fokkers, rookfakkels, motor, clubs, samen, cadeaubon } = prijzen;
const dierenAanvullend = [...(dieren.aanvullend || []), reiskostenRegel];

// Teasers voor categorieën met een eigen landingspagina (details staan daar).
const teasers = [
  { data: puppy, href: '/puppyshoot', linktekst: 'Puppyshoot, puppyjaar & nestreportage →' },
  { data: rookfakkels, href: '/rookfakkels', linktekst: 'Bekijk rookfakkelshoots →' },
  { data: motor, href: '/motor', linktekst: 'Bekijk motorshoots →' },
];
---

<Base title="Prijzen dierenfotografie Rotterdam" description="Pakketten voor dierenfotografie in Rotterdam en omgeving. Dieren, puppy's, agility, rookfakkels en motoren. Shoots vanaf €65.">
  <section class="container section">
    <h1 class="page-title">Diensten &amp; Prijzen</h1>

    <!-- Dieren: hoofdblok, drie gelijke kaarten -->
    <div class="prijs-blok">
      <div class="blok-kop"><h2>{dieren.titel}</h2></div>
      <p class="blok-intro">{dieren.intro}</p>
      <div class="package-grid primary-grid">
        {dieren.pakketten.map((p) => <PackageCard pakket={p} />)}
      </div>
      <ul class="extras">
        {dierenAanvullend.map((e) => <li>{e}</li>)}
      </ul>
    </div>

    <Reviews count={3} />

    <!-- Puppy, Creatief & thema, Motor: teasers naar de eigen pagina's -->
    <div class="secundair-rij drie">
      {teasers.map((s) => (
        <div class="prijs-blok klein landing-kaart">
          <div class="blok-kop"><h2>{s.data.titel}</h2></div>
          {s.data.intro && <p class="blok-intro klein-intro">{s.data.intro}</p>}
          <div class="package-grid">
            {s.data.pakketten.slice(0, 1).map((p) => <PackageCard pakket={p} />)}
          </div>
          <p class="landing-link"><a href={s.href}>{s.linktekst}</a></p>
        </div>
      ))}
    </div>

    <!-- Clubs & verenigingen -->
    <div class="prijs-blok zakelijk">
      <div class="blok-kop"><h2>{clubs.titel}</h2></div>
      <p class="blok-intro">{clubs.intro}</p>
      <div class="package-grid twee-kolom">
        {clubs.pakketten.map((p) => <PackageCard pakket={p} />)}
      </div>
      {clubs.note && <p class="klein-note">{clubs.note}</p>}
    </div>

    <!-- Samen boeken + Cadeaubon -->
    <div class="secundair-rij">
      <div class="prijs-blok klein">
        <div class="blok-kop"><h2>{samen.titel}</h2></div>
        <p class="blok-intro klein-intro">{samen.tekst}</p>
      </div>
      <div class="prijs-blok klein">
        <div class="blok-kop"><h2>{cadeaubon.titel}</h2></div>
        <p class="blok-intro klein-intro">{cadeaubon.tekst}</p>
        <p class="landing-link"><a href="/cadeaubon">Cadeaubon aanvragen →</a></p>
      </div>
    </div>

    <div class="band-inner center">
      <h2>Niet zeker welk pakket past?</h2>
      <p>Stuur me een berichtje, dan denk ik met je mee.</p>
      <a href="/contact" class="btn btn-primary">Neem contact op</a>
    </div>
  </section>
</Base>
