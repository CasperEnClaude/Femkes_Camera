---
import Base from '../layouts/Base.astro';
import PackageCard from '../components/PackageCard.astro';
import prijzen from '../data/prijzen.json';
import site from '../data/site.json';

const { dieren, rookfakkels, motor, dierensport } = prijzen;

const plaats = site.plaatsnaam && !site.plaatsnaam.startsWith('[') ? site.plaatsnaam : null;
const straal = site.reiskosten_straal_km || '15';
const reiskostenRegel = plaats
  ? `Reiskosten €0,30/km buiten ${straal} km van ${plaats}`
  : `Reiskosten €0,30/km buiten ${straal} km (regio in overleg)`;
const dierenExtras = [...(dieren.extras || []), reiskostenRegel];

// Secundaire kaarten (Rookfakkels & Motor) — zelfde warme stijl als de rest.
const secundair = [
  { data: rookfakkels, href: '/rookfakkels', linktekst: 'Bekijk rookfakkel-shoots →' },
  { data: motor, href: '/motor', linktekst: 'Bekijk motorshoots →' },
];
---

<Base title="Diensten & Prijzen" description="Pakketten voor dierenfotografie vanaf €65. Plus rookfakkel-, motor- en dierensportfotografie.">
  <section class="container section">
    <h1 class="page-title">Diensten &amp; Prijzen</h1>

    <!-- Dieren: hoofdaanbod, bovenaan en het grootst -->
    <div class="prijs-blok">
      <div class="blok-kop">
        <h2>{dieren.titel}</h2>
        <span class="blok-sub">{dieren.ondertitel}</span>
      </div>
      <p class="blok-intro">{dieren.intro}</p>
      <div class="package-grid primary-grid">
        {dieren.pakketten.map((p) => <PackageCard pakket={p} />)}
      </div>
      <ul class="extras">
        {dierenExtras.map((e) => <li>{e}</li>)}
      </ul>
    </div>

    <!-- Dierensport & Evenementen: boven de secundaire categorieën (motor/fakkel) -->
    <div class="prijs-blok zakelijk">
      <div class="blok-kop">
        <h2>{dierensport.titel}</h2>
        <span class="blok-sub">{dierensport.ondertitel}</span>
      </div>
      <div class="package-grid">
        {dierensport.pakketten.map((p) => <PackageCard pakket={p} />)}
      </div>
    </div>

    <!-- Rookfakkels & Motor: secundair, met eigen sub-opties en link naar de landingspagina -->
    <div class="secundair-rij">
      {secundair.map((s) => (
        <div class="prijs-blok klein landing-kaart">
          <div class="blok-kop">
            <h2>{s.data.titel}</h2>
            <span class="blok-sub">{s.data.ondertitel}</span>
          </div>
          {s.data.intro && <p class="blok-intro klein-intro">{s.data.intro}</p>}
          <div class="package-grid">
            {s.data.pakketten.map((p) => <PackageCard pakket={p} />)}
          </div>
          <p class="klein-note">Losse opties en extra's? Die leg ik uit op de eigen pagina.</p>
          <p class="landing-link"><a href={s.href}>{s.linktekst}</a></p>
        </div>
      ))}
    </div>

    <div class="band-inner center">
      <h2>Niet zeker welk pakket past?</h2>
      <p>Stuur me een berichtje, dan denk ik met je mee.</p>
      <a href="/contact" class="btn btn-primary">Neem contact op</a>
    </div>
  </section>
</Base>
