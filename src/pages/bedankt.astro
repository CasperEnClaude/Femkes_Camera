---
import Base from '../layouts/Base.astro';
---

<Base title="Bedankt!" description="Je boekingsaanvraag is verstuurd. Femke neemt zo snel mogelijk contact met je op.">
  <section class="container section narrow center">
    <div class="bedankt-icon" aria-hidden="true">🐾</div>
    <h1 class="page-title">Bedankt voor je aanvraag!</h1>
    <p class="prose">Je bericht is verstuurd. Ik neem zo snel mogelijk contact met je op om de shoot af te stemmen. Check ook je spam-map voor de zekerheid.</p>
    <div class="hero-cta center-cta">
      <a href="/portfolio" class="btn btn-primary">Bekijk mijn werk</a>
      <a href="/" class="btn btn-ghost">Terug naar home</a>
    </div>
  </section>
</Base>
