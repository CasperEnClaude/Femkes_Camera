---
import Base from '../layouts/Base.astro';
---

<Base title="Pagina niet gevonden" description="Deze pagina bestaat niet (meer).">
  <section class="container section narrow center" style="min-height: 48vh;">
    <h1 class="page-title">Oeps, deze pagina is er niet 🐾</h1>
    <p class="prose">Misschien is de link verouderd of klopte er iets niet. Geen zorgen, je vindt hier vast wat je zoekt:</p>
    <div class="hero-cta" style="justify-content: center;">
      <a href="/" class="btn btn-primary">Naar de homepagina</a>
      <a href="/portfolio" class="btn btn-ghost">Bekijk het portfolio</a>
    </div>
  </section>
</Base>
