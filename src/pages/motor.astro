---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import PackageCard from '../components/PackageCard.astro';
import InstaIcon from '../components/InstaIcon.astro';
import { resolveImage } from '../lib/images.js';
import { igUrl } from '../lib/site.js';
import motorGallery from '../galleries/motor.json';
import prijzen from '../data/prijzen.json';

const motor = prijzen.motor;

// Sfeervolle motorfoto als hero-achtergrond (silhouet tegen het licht).
const heroPhoto = motorGallery.photos?.[4] || motorGallery.photos?.[0];
const heroImg = heroPhoto ? resolveImage(heroPhoto.image) : undefined;
---

<Base
  title="Motorfotografie"
  description="Motorfotografie door Femke's Camera — stoere, sfeervolle beelden van jouw motor, met of zonder rijder."
>
  <section class="hero photo-hero">
    {heroImg ? (
      <Image src={heroImg} alt={heroPhoto.naam || 'Motorfotografie'} widths={[600, 1200, 1800]} sizes="100vw" loading="eager" class="hero-img" />
    ) : (
      <div class="hero-img hero-placeholder" aria-hidden="true"></div>
    )}
    <div class="hero-overlay">
      <div class="container hero-content">
        <span class="hero-kicker">Stoer &amp; sfeervol</span>
        <h1>Motorfotografie</h1>
        <p class="hero-lead">Naast dieren richt ik mijn lens graag op motoren — stoere, sfeervolle beelden van jouw machine, met of zonder rijder. Een nieuw onderdeel van mijn werk, dus scherp geprijsd.</p>
        <div class="hero-cta">
          <a href="/contact?pakket=Motorshoot" class="btn btn-primary">Plan een motorshoot</a>
          {igUrl && <a href={igUrl} class="btn btn-ghost" rel="noopener" target="_blank"><InstaIcon size={18} cls="btn-ico" /> Instagram</a>}
        </div>
      </div>
    </div>
  </section>

  <section class="container section">
    <h2 class="cat-heading">Werk</h2>
    <Gallery gallery={motorGallery} />
  </section>

  <section class="container section">
    <h2 class="cat-heading">Wat een motorshoot kost</h2>
    <div class="landing-prijs">
      <div class="package-grid single">
        {motor.pakketten.map((p) => <PackageCard pakket={p} />)}
      </div>
      <div class="opties-blok">
        <h3>Uitbreiden kan</h3>
        <ul class="opties-lijst">
          {motor.opties.map((o) => (
            <li>
              <span class="optie-naam">{o.naam}{o.hint && <span class="optie-hint"> — {o.hint}</span>}</span>
              <span class="optie-prijs">{o.meerprijs}</span>
            </li>
          ))}
          {motor.addon && (
            <li class="optie-addon">
              <span class="optie-naam">{motor.addon.naam} <span class="optie-badge">op aanvraag</span></span>
              <span class="optie-prijs">{motor.addon.meerprijs}</span>
            </li>
          )}
        </ul>
      </div>
    </div>
    <p class="klein-note center">Prijs kan omhoog zodra er meer voorbeelden in dit portfolio staan.</p>
  </section>

  <section class="band">
    <div class="container band-inner center">
      <h2>Jouw motor voor de lens?</h2>
      <p>Stuur me een bericht — ik denk graag mee over locatie en sfeer.</p>
      <a href="/contact?pakket=Motorshoot" class="btn btn-primary">Neem contact op</a>
    </div>
  </section>
</Base>
