---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import PackageCard from '../components/PackageCard.astro';
import Reviews from '../components/Reviews.astro';
import InstaIcon from '../components/InstaIcon.astro';
import { resolveImage } from '../lib/images.js';
import { igUrl, werkgebiedBasis } from '../lib/site.js';
import agilityGallery from '../galleries/agility.json';
import prijzen from '../data/prijzen.json';

const clubs = prijzen.clubs;
const heroPhoto = agilityGallery.photos?.[0];
const heroImg = heroPhoto ? resolveImage(heroPhoto.image) : undefined;
---

<Base
  title="Agility fotografie Rotterdam en omgeving"
  description="Agility- en hondensportfotografie in Rotterdam en omgeving. Scherpe actiebeelden van de baan — voor clubs, evenementen en individuele deelnemers."
>
  <section class="hero photo-hero">
    {heroImg ? (
      <Image src={heroImg} alt={heroPhoto.naam || 'Agility fotografie'} widths={[600, 1200, 1800]} sizes="100vw" loading="eager" class="hero-img" />
    ) : (
      <div class="hero-img hero-placeholder" aria-hidden="true"></div>
    )}
    <div class="hero-overlay">
      <div class="container hero-content">
        <span class="hero-kicker">Agility &amp; hondensport</span>
        <h1>Agility fotografie {werkgebiedBasis || 'in de regio'}</h1>
        <p class="hero-lead">Snelheid, focus en die klik tussen jou en je hond — vastgelegd op de baan.</p>
        <div class="hero-cta">
          <a href="/contact?pakket=Clubs%20%26%20verenigingen" class="btn btn-primary">Vraag een shoot aan</a>
          {igUrl && <a href={igUrl} class="btn btn-ghost" rel="noopener" target="_blank"><InstaIcon size={18} cls="btn-ico" /> Instagram</a>}
        </div>
      </div>
    </div>
  </section>

  <section class="container section narrow">
    <p class="prose">Agility is mijn eigen sport. Ik sta zelf op de baan, ken de looplijnen en weet waar het moment ontstaat — bij de sprong, in de tunnel, op dat ene stukje waar hond en baas volledig op elkaar zijn afgestemd. Daardoor kom ik op plekken en momenten die een fotograaf van buiten de sport gemakkelijk mist.</p>
    <p class="prose">Ik fotografeer agility en hondensport in {werkgebiedBasis || 'Rotterdam en omgeving'}: scherpe actiebeelden met snelheid en spanning erin, plus rustigere momenten ernaast. Voor clubs en evenementen leg ik de hele dag vast; voor individuele deelnemers maak ik gerichte beelden van jou en je hond. Ideaal voor social media, het clubblad of gewoon om trots te delen.</p>
  </section>

  <section class="container section">
    <h2 class="cat-heading">Voor clubs en evenementen</h2>
    <p class="blok-intro">{clubs.intro}</p>
    <div class="package-grid twee-kolom">
      {clubs.pakketten.map((p) => <PackageCard pakket={p} />)}
    </div>
    {clubs.note && <p class="klein-note">{clubs.note}</p>}
    <p class="landing-link"><a href="/prijzen">Individuele shoot? Bekijk de dierenpakketten →</a></p>
  </section>

  <section class="container section">
    <h2 class="cat-heading">Werk</h2>
    <Gallery gallery={agilityGallery} />
  </section>

  <section class="container section"><Reviews category="agility" count={3} /></section>

  <section class="band">
    <div class="container band-inner center">
      <h2>Jouw club of jouw hond op de baan?</h2>
      <p>Stuur me een bericht, dan stemmen we het samen af.</p>
      <a href="/contact?pakket=Clubs%20%26%20verenigingen" class="btn btn-primary">Neem contact op</a>
    </div>
  </section>
</Base>
