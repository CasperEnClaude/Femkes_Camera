---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { resolveImage } from '../lib/images.js';
import { igUrl } from '../lib/site.js';
import teksten from '../data/teksten.json';
import site from '../data/site.json';

const paragraphs = teksten.over_mij_body.split('\n\n');
const foto = teksten.over_mij_foto ? resolveImage(teksten.over_mij_foto) : undefined;
const plaats = site.plaatsnaam && !site.plaatsnaam.startsWith('[') ? site.plaatsnaam : null;
---

<Base title="Wie ben ik?" description="Femke fotografeert dieren met geduld en oog voor gedrag. 21 jaar, opleiding Dier en Ondernemen, werkt dagelijks in een dierenspeciaalzaak.">
  <section class="container section narrow">
    <h1 class="page-title">{teksten.over_mij_titel}</h1>
    {foto && (
      <Image src={foto} alt="Femke van Femke's Camera met haar twee Australian Shepherds" widths={[400, 600, 800, 1100]} sizes="(max-width: 620px) 90vw, 460px" quality={86} loading="eager" class="over-foto" />
    )}
    {paragraphs.map((p) => <p class="prose">{p}</p>)}
    {plaats && <p class="prose">Ik werk in en rond {plaats} — kom je van net iets verder? Vraag gerust, meestal komen we er samen uit.</p>}

    <div class="hero-cta">
      <a href="/portfolio" class="btn btn-primary">Bekijk mijn werk</a>
      <a href="/contact" class="btn btn-ghost">Boek een shoot</a>
    </div>
  </section>
</Base>
