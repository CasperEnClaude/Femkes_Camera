---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import InstaFollow from '../components/InstaFollow.astro';
import InstaIcon from '../components/InstaIcon.astro';
import { resolveImage } from '../lib/images.js';
import { igHandle, igUrl, plaats, werkgebiedBasis } from '../lib/site.js';
import teksten from '../data/teksten.json';
import honden from '../galleries/honden.json';
import puppys from '../galleries/puppys.json';
import agility from '../galleries/agility.json';
import paarden from '../galleries/paarden.json';
import creative from '../galleries/creative.json';
import motor from '../galleries/motor.json';

// Sterkste hondenfoto als hero (eerste foto uit de Honden-galerij).
const heroPhoto = honden.photos?.[0];
const heroImg = heroPhoto ? resolveImage(heroPhoto.image) : undefined;

const homeDescription = plaats
  ? `Dierenfotografie door Femke's Camera in en rond ${plaats} — natuurlijke foto's van dierensport, paarden, honden en puppy's, met geduld en oog voor karakter.`
  : "Dierenfotografie door Femke's Camera — natuurlijke foto's van dierensport, paarden, honden en puppy's, met geduld en oog voor karakter.";

const prep = (arr) => arr.map((c) => ({ ...c, img: c.foto ? resolveImage(c.foto.image) : undefined }));

// Volgorde zoals Femke het liefst fotografeert. Dieren eerst, dan (met scheiding) de extra's.
const dierCategorieen = prep([
  { titel: 'Agility & sport evenementen', href: '/portfolio#agility', tekst: 'Snelheid, focus en jullie band op de baan.', foto: agility.photos?.[0] },
  { titel: 'Paarden', href: '/portfolio#paarden', tekst: 'Kracht en rust — paarden in hun element.', foto: paarden.photos?.[0] },
  { titel: 'Honden', href: '/portfolio#honden', tekst: 'Beelden waar je jaren later nog trots op bent.', foto: honden.photos?.[3] },
  { titel: "Puppy's", href: '/portfolio#puppys', tekst: 'Leg die eerste weken vast — ze zijn zó voorbij.', foto: puppys.photos?.[0] },
]);
const extraCategorieen = prep([
  { titel: 'Rookfakkels', href: '/rookfakkels', tekst: 'Kleurrijke rook, stoere beelden die opvallen.', foto: creative.photos?.[0] },
  { titel: 'Motor', href: '/motor', tekst: 'Jouw machine sfeervol in beeld.', foto: motor.photos?.[4] },
]);
---

<Base title="Dierenfotograaf Rotterdam" description={homeDescription}>
  <section class="hero">
    {heroImg ? (
      <Image src={heroImg} alt={heroPhoto.naam || 'Hondenfotografie door Femke\'s Camera'} widths={[600, 1200, 1800]} sizes="100vw" loading="eager" class="hero-img" />
    ) : (
      <div class="hero-img hero-placeholder" aria-hidden="true"></div>
    )}
    <div class="hero-overlay">
      <div class="container hero-content">
        {igHandle && (
          <a href={igUrl} class="hero-ig-chip" rel="noopener" target="_blank">
            <InstaIcon size={16} /> @{igHandle}
          </a>
        )}
        <h1>{teksten.home_titel}</h1>
        <p class="hero-lead">Natuurlijke foto's van je huisdier — met rust en geduld.</p>
        <div class="hero-cta">
          <a href="/contact" class="btn btn-primary">Boek een shoot</a>
          <a href="/portfolio" class="btn btn-ghost">Bekijk portfolio</a>
        </div>
      </div>
    </div>
  </section>

  <div class="hero-strip">
    <div class="container">Shoots vanaf €65{werkgebiedBasis ? ` · ${werkgebiedBasis}, daarbuiten in overleg` : ''}</div>
  </div>

  <section class="container section">
    <h2 class="section-title">Wat ik fotografeer</h2>
    <p class="section-intro">Ik fotografeer honden, puppy's, agility en paarden. Daarnaast maak ik creatieve shoots met rookfakkels en fotografeer ik motoren.</p>

    <div class="cat-grid four">
      {dierCategorieen.map((c) => (
        <a href={c.href} class="cat-card">
          {c.img ? (
            <Image src={c.img} alt={c.foto?.naam || c.titel} widths={[300, 600]} sizes="(max-width: 640px) 50vw, 240px" loading="lazy" class="cat-img" />
          ) : (
            <span class="cat-img cat-img-fallback" aria-hidden="true"></span>
          )}
          <span class="cat-overlay">
            <span class="cat-titel">{c.titel}</span>
          </span>
        </a>
      ))}
    </div>

    <hr class="cat-divider" />

    <div class="cat-grid two">
      {extraCategorieen.map((c) => (
        <a href={c.href} class="cat-card">
          {c.img ? (
            <Image src={c.img} alt={c.foto?.naam || c.titel} widths={[300, 600]} sizes="(max-width: 640px) 50vw, 240px" loading="lazy" class="cat-img" />
          ) : (
            <span class="cat-img cat-img-fallback" aria-hidden="true"></span>
          )}
          <span class="cat-overlay">
            <span class="cat-titel">{c.titel}</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="container section why-section">
    <div class="why-grid">
      <div class="why-item"><span class="why-ico" aria-hidden="true">🐾</span><h3>Ik ken dieren</h3><p>Elke dag werk ik met dieren in een dierenspeciaalzaak. Ik lees hun gedrag en stel ze op hun gemak.</p></div>
      <div class="why-item"><span class="why-ico" aria-hidden="true">⏳</span><h3>Alle geduld</h3><p>Werkt je huisdier even niet mee? Dan wachten we rustig af. Geen druk, geen geforceerde standjes.</p></div>
      <div class="why-item"><span class="why-ico" aria-hidden="true">✨</span><h3>Beelden die blijven</h3><p>Natuurlijk en herkenbaar — foto's waarin je je huisdier écht terugziet, klaar voor print en social.</p></div>
    </div>
  </section>

  <InstaFollow count={6} />

  <section class="band">
    <div class="container band-inner">
      <h2>Klaar voor mooie foto's van je huisdier?</h2>
      <p>Ik denk graag met je mee over het juiste pakket.</p>
      <div class="hero-cta center-cta">
        <a href="/contact" class="btn btn-primary">Boek een shoot</a>
        {igUrl && <a href={igUrl} class="btn btn-ghost" rel="noopener" target="_blank"><InstaIcon size={18} cls="btn-ico" /> Volg op Instagram</a>}
      </div>
    </div>
  </section>
</Base>
