---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { resolveImage } from '../lib/images.js';
import teksten from '../data/teksten.json';
import site from '../data/site.json';
import honden from '../galleries/honden.json';

// Sterkste hondenfoto als hero (eerste foto uit de Honden-galerij).
const heroPhoto = honden.photos?.[0];
const heroImg = heroPhoto ? resolveImage(heroPhoto.image) : undefined;

const plaats = site.plaatsnaam && !site.plaatsnaam.startsWith('[') ? site.plaatsnaam : null;
const homeDescription = plaats
  ? `Dierenfotografie door Femke's Camera in en rond ${plaats} — natuurlijke foto's van honden, puppy's en agility, met geduld en oog voor karakter.`
  : "Dierenfotografie door Femke's Camera — natuurlijke foto's van honden, puppy's en agility, met geduld en oog voor karakter.";

const categorieen = [
  { titel: 'Honden', href: '/portfolio#honden', groot: true, tekst: 'Van rustige portretten tot volle actie — beelden waar je jaren later nog trots op bent.' },
  { titel: "Puppy's", href: "/portfolio#puppys", groot: true, tekst: 'Die eerste weken zijn zo voorbij. Leg je pups vast — om te koesteren én om harten te veroveren.' },
  { titel: 'Agility', href: '/portfolio#agility', groot: true, tekst: 'Snelheid, focus en flow — laat de sport én jullie band zien.' },
  { titel: 'Rookfakkels', href: '/rookfakkels', groot: false, tekst: 'Kleurrijke rook rond je hond: stoere beelden die opvallen.' },
  { titel: 'Motor', href: '/motor', groot: false, tekst: 'Jouw machine sfeervol in beeld — elk merk welkom.' },
];
---

<Base description={homeDescription}>
  <section class="hero">
    {heroImg ? (
      <Image src={heroImg} alt={heroPhoto.naam || 'Hondenfotografie door Femke\'s Camera'} widths={[600, 1200, 1800]} sizes="100vw" loading="eager" class="hero-img" />
    ) : (
      <div class="hero-img hero-placeholder" aria-hidden="true"></div>
    )}
    <div class="hero-overlay">
      <div class="container hero-content">
        <h1>{teksten.home_titel}</h1>
        <p class="hero-lead">{teksten.home_intro}</p>
        <div class="hero-cta">
          <a href="/prijzen" class="btn btn-primary">Bekijk pakketten</a>
          <a href="/contact" class="btn btn-ghost">Boek een shoot</a>
        </div>
      </div>
    </div>
  </section>

  <section class="container section">
    <h2 class="section-title">Wat ik fotografeer</h2>
    <p class="section-intro">Dieren zijn mijn hoofdaanbod. Daarnaast doe ik af en toe iets creatiefs of een motorshoot.</p>

    <div class="cat-grid">
      {categorieen.map((c) => (
        <a href={c.href} class:list={['cat-card', { big: c.groot, small: !c.groot }]}>
          <span class="cat-titel">{c.titel}</span>
          <span class="cat-tekst">{c.tekst}</span>
          <span class="cat-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>

  <section class="band">
    <div class="container band-inner">
      <h2>Klaar voor mooie foto's van je huisdier?</h2>
      <p>Ik denk graag met je mee over het juiste pakket.</p>
      <a href="/contact" class="btn btn-primary">Neem contact op</a>
    </div>
  </section>
</Base>
