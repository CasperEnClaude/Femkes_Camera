---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import PackageCard from '../components/PackageCard.astro';
import Reviews from '../components/Reviews.astro';
import Walkthrough from '../components/Walkthrough.astro';
import Faq from '../components/Faq.astro';
import InstaIcon from '../components/InstaIcon.astro';
import { resolveImage } from '../lib/images.js';
import { igUrl, werkgebiedBasis } from '../lib/site.js';
import paardenGallery from '../galleries/paarden.json';
import prijzen from '../data/prijzen.json';

const dieren = prijzen.dieren;
const heroPhoto = paardenGallery.photos?.[0];
const heroImg = heroPhoto ? resolveImage(heroPhoto.image) : undefined;

const stappen = [
  { titel: 'Even afstemmen', tekst: 'We bespreken vooraf wat je wilt, waar we fotograferen en of je zelf mee op de foto wilt.' },
  { titel: 'Rustig beginnen', tekst: 'Je paard mag eerst even wennen aan mij en de camera. Ik werk rustig en zonder haast.' },
  { titel: 'De shoot zelf', tekst: 'Ik wacht het juiste moment af — de blik, de houding, die stille band tussen jullie.' },
  { titel: 'Selectie & bewerking', tekst: 'Ik kies de sterkste beelden en bewerk ze in mijn eigen, natuurlijke stijl.' },
  { titel: 'Levering', tekst: 'Je ontvangt je foto\'s digitaal via een online galerij.' },
];

const vragen = [
  { vraag: 'Waar vindt een paardenshoot plaats?', antwoord: 'In de manege, in de bak of los in het veld — waar jij en je paard je op je gemak voelen. We kiezen de plek samen.' },
  { vraag: 'Moet ik zelf op de foto?', antwoord: 'Dat mag, maar het hoeft niet. Portretten van alleen je paard kunnen net zo goed.' },
  { vraag: 'Wat als mijn paard onrustig is?', antwoord: 'Dan nemen we de tijd. Ik werk rustig en wacht het juiste moment af.' },
  { vraag: 'Wanneer ontvang ik de foto\'s?', antwoord: 'Dat spreken we samen af; meestal lukt dat binnen een paar weken.' },
];
---

<Base
  title="Paardenfotograaf Rotterdam"
  description="Paardenfotografie in regio Rotterdam — rustige, sfeervolle beelden van jou en je paard. In de manege, in de bak of los in het veld."
>
  <section class="hero photo-hero">
    {heroImg ? (
      <Image src={heroImg} alt={heroPhoto.naam || 'Paardenfotografie'} widths={[600, 1200, 1800]} sizes="100vw" loading="eager" class="hero-img" />
    ) : (
      <div class="hero-img hero-placeholder" aria-hidden="true"></div>
    )}
    <div class="hero-overlay">
      <div class="container hero-content">
        <span class="hero-kicker">Paardenfotografie</span>
        <h1>Paardenfotografie {werkgebiedBasis || 'in de regio'}</h1>
        <p class="hero-lead">Rustige, sfeervolle beelden van jou en je paard.</p>
        <div class="hero-cta">
          <a href="/contact?pakket=Plus" class="btn btn-primary">Plan een shoot</a>
          {igUrl && <a href={igUrl} class="btn btn-ghost" rel="noopener" target="_blank"><InstaIcon size={18} cls="btn-ico" /> Instagram</a>}
        </div>
      </div>
    </div>
  </section>

  <section class="container section narrow">
    <p class="prose">Paarden hebben een speciaal plekje bij me — ik geniet er enorm van om ze te fotograferen. In de manege, in de bak of los in het veld: ik zoek naar de rust, de kracht en die stille band tussen ruiter en paard.</p>
    <p class="prose">Omdat ik dagelijks met dieren werk, weet ik hoe ik een paard de tijd geef en het moment afwacht. Zo krijgen we natuurlijke beelden zonder gestuur — precies zoals jullie samen zijn.</p>
  </section>

  <section class="container section">
    <h2 class="cat-heading">Pakketten</h2>
    <p class="blok-intro">{dieren.intro}</p>
    <div class="package-grid primary-grid">
      {dieren.pakketten.map((p) => <PackageCard pakket={p} />)}
    </div>
    <p class="landing-link"><a href="/prijzen">Alle prijzen en extra's →</a></p>
  </section>

  <section class="container section">
    <h2 class="cat-heading">Werk</h2>
    <Gallery gallery={paardenGallery} />
  </section>

  <section class="container section narrow">
    <Walkthrough stappen={stappen} />
  </section>

  <section class="container section"><Reviews category="paarden" count={3} /></section>

  <section class="container section narrow">
    <Faq vragen={vragen} />
  </section>

  <section class="band">
    <div class="container band-inner center">
      <h2>Jou en je paard voor de lens?</h2>
      <p>Stuur me een bericht, dan stemmen we het samen af.</p>
      <a href="/contact?pakket=Plus" class="btn btn-primary">Neem contact op</a>
    </div>
  </section>
</Base>
