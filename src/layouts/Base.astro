---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
import '../styles/global.css';

const {
  title,
  description = 'Dierenfotografie door Femke\'s Camera in Rotterdam en omgeving — natuurlijke foto\'s van honden, puppy\'s, agility en paarden.',
  theme = 'light', // 'light' (hoofdsite) of 'motor' (donker/groen subthema)
  ogImage = '/og-image.jpg',
} = Astro.props;

const fullTitle = title
  ? `${title} | ${site.merknaam}`
  : `${site.merknaam} — ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site).toString();

// LocalBusiness structured data — helpt lokale vindbaarheid. Adres/regio en
// social alleen meegeven als ze echt zijn ingevuld (geen placeholders).
const plaats = site.plaatsnaam && !site.plaatsnaam.startsWith('[') ? site.plaatsnaam : null;
const igHandle = site.instagram_dieren && !site.instagram_dieren.startsWith('[')
  ? site.instagram_dieren.replace('@', '')
  : null;
const homeUrl = Astro.site ? Astro.site.toString() : undefined;
const diensten = [
  'Dierenfotografie',
  'Hondenfotografie',
  'Puppyfotografie',
  'Paardenfotografie',
  'Agility- en hondensportfotografie',
  'Rookfakkel- en creatieve fotografie',
  'Motorfotografie',
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['ProfessionalService', 'LocalBusiness'],
  '@id': homeUrl ? `${homeUrl}#business` : undefined,
  name: site.merknaam,
  description: `${site.merknaam} is een fotograaf uit de regio Rotterdam, gespecialiseerd in dierenfotografie: honden, puppy's, paarden en agility. Daarnaast creatieve fotografie met rookfakkels en motorfotografie.`,
  slogan: site.tagline,
  url: homeUrl,
  image: Astro.site ? new URL('/og-image.jpg', Astro.site).toString() : undefined,
  priceRange: '€65–€325',
  knowsAbout: diensten,
  areaServed: [
    { '@type': 'City', name: 'Rotterdam' },
    { '@type': 'AdministrativeArea', name: 'Zuid-Holland' },
  ],
  founder: { '@type': 'Person', name: 'Femke' },
  makesOffer: diensten.map((d) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: d, areaServed: 'Rotterdam' } })),
  ...(plaats ? { address: { '@type': 'PostalAddress', addressLocality: plaats, addressRegion: 'Zuid-Holland', addressCountry: 'NL' } } : {}),
  ...(igHandle ? { sameAs: [`https://instagram.com/${igHandle}`] } : {}),
};
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.merknaam} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="theme-color" content={theme === 'motor' ? '#12140f' : '#c8794f'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body class={theme === 'motor' ? 'theme-motor' : 'theme-light'}>
    <a class="skip-link" href="#main">Naar inhoud</a>
    <Header theme={theme} />
    <main id="main">
      <slot />
    </main>
    <Footer theme={theme} />

    <!-- Lightbox: klik op een portfoliofoto toont 'm groot. Geen externe library. -->
    <div id="lightbox" class="lightbox" hidden>
      <button type="button" class="lightbox-close" aria-label="Sluiten">&times;</button>
      <img class="lightbox-img" alt="" />
    </div>
    <script is:inline>
      (function () {
        var lb = document.getElementById('lightbox');
        if (!lb) return;
        var lbImg = lb.querySelector('.lightbox-img');
        function grootste(img) {
          var src = img.currentSrc || img.src;
          if (img.srcset) {
            var best = { url: src, w: 0 };
            img.srcset.split(',').forEach(function (part) {
              var bits = part.trim().split(/\s+/);
              var w = parseInt(bits[1]) || 0;
              if (w > best.w) best = { url: bits[0], w: w };
            });
            src = best.url;
          }
          return src;
        }
        function sluit() { lb.hidden = true; lbImg.removeAttribute('src'); document.body.style.overflow = ''; }
        document.addEventListener('click', function (e) {
          var img = e.target.closest('.gallery-grid img');
          if (img) { lbImg.src = grootste(img); lbImg.alt = img.alt || ''; lb.hidden = false; document.body.style.overflow = 'hidden'; return; }
          if (e.target.closest('#lightbox')) sluit();
        });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !lb.hidden) sluit(); });
      })();
    </script>

    <!-- Klein knipoogje: ander tabblad-titeltje als je de site even verlaat. -->
    <script is:inline>
      (function () {
        var orig = document.title;
        document.addEventListener('visibilitychange', function () {
          document.title = document.hidden ? '🐾 Tot snel bij Femke!' : orig;
        });
      })();
    </script>

    <!-- Netlify Identity: vangt de uitnodigings-/inloglink op en stuurt door naar /admin.
         Alleen nodig voor Femke's beheerlogin; laadt met defer zodat het de site niet vertraagt. -->
    <script defer src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    <script>
      window.addEventListener('load', function () {
        if (window.netlifyIdentity) {
          window.netlifyIdentity.on('init', function (user) {
            if (!user) {
              window.netlifyIdentity.on('login', function () {
                document.location.href = '/admin/';
              });
            }
          });
        }
      });
    </script>
  </body>
</html>
